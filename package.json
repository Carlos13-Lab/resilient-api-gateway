{
  "name": "resilient-api-gateway",
  "version": "0.1.0",
  "description": "Fastify API gateway that unifies heterogeneous upstreams behind one contract, with production resilience patterns.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "token": "node scripts/demo-token.mjs"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "opossum": "^10.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opossum": "^8.1.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
